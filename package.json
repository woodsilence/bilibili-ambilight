{
  "name": "bilibili-ambilight",
  "version": "0.0.1",
  "description": "This browser extension adds ambient light to the videos you view on Bilibili",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodsilence/bilibili-ambilight.git"
  },
  "author": "woodsilence",
  "license": "ISC",
  "homepage": "https://github.com/woodsilence/bilibili-ambilight#readme",
  "type": "module",
  "scripts": {
    "build:manifest": "node manifest-copy.js",
    "build:html": "copyfiles -u 1 src/options.html dist",
    "build:images": "copyfiles -u 2 src/images/* dist/images",
    "build:styles:content": "sass --no-source-map src/styles/content.scss dist/styles/content.css",
    "build:styles:options": "copyfiles -u 2 src/styles/options.css dist/styles",
    "build:styles": "run-p build:styles:content build:styles:options",
    "build:scripts": "rollup -c",
    "build": "run-s build:scripts build:styles build:manifest build:html build:images",
    "pack": "node pack.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.8",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-eslint": "^9.0.5",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "babel-plugin-transform-replace-expressions": "^0.2.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.42.0",
    "sass": "^1.62.1"
  },
  "overrides": {
    "@rollup/plugin-eslint": {
      "eslint": "$eslint"
    }
  }
}